    {
      "parameters": {
        "jsCode": "// ===== Detectar respuestas desde Tally =====\nconst answers =\n  $json.body?.answers ||\n  $json.body?.data?.fields ||\n  [];\n\n// ===== Detectar PLAN según webhook =====\nlet plan = \"desconocido\";\nconst webhookUrl = $json.webhookUrl || \"\";\n\nif (webhookUrl.includes(\"starter\")) {\n  plan = \"starter\";\n}\nif (webhookUrl.includes(\"growth\")) {\n  plan = \"growth\";\n}\nif (webhookUrl.includes(\"premium\")) {\n  plan = \"premium\";\n}\n\n// ===== Objeto normalizado =====\nlet data = {\n  plan: plan\n};\n\n// ===== Recorrer preguntas =====\nfor (const a of answers) {\n\n  const label = a.label?.toLowerCase() || \"\";\n  const value = a.value;\n\n  if (label.includes(\"descripción breve\")) {\n    data.descripcion_negocio = value;\n  }\n\n  if (label.includes(\"tono\")) {\n    data.tono_marca = value;\n  }\n\n  if (label.includes(\"herramientas\")) {\n    data.herramientas = value;\n  }\n\n  if (label.includes(\"fechas\")) {\n    data.fecha_evento = value;\n  }\n\n  if (label.includes(\"métricas\")) {\n    data.metricas = value;\n  }\n\n  if (label.includes(\"procesos\")) {\n    data.procesos = value;\n  }\n\n  if (label.includes(\"integraciones\")) {\n    data.integraciones = value;\n  }\n\n  if (label.includes(\"presupuesto\")) {\n    data.presupuesto = value;\n  }\n\n  if (label.includes(\"roles\")) {\n    data.roles_equipo = value;\n  }\n\n  if (label.includes(\"requerimiento\")) {\n    data.requerimientos = value;\n  }\n\n  if (label.includes(\"documentación\")) {\n    data.documentacion = value;\n  }\n}\n\n// ===== Output final =====\nreturn [{ json: { ...$json, ...data } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        368
      ],
      "id": "b0986d04-d8b5-4c5e-b6a0-09a6c0012b2b",
      "name": "Code in JavaScript1"
    },
