        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  records: [\n    {\n      fields: {\n        empresa: $json.body.data.fields.find(f => f.label.toLowerCase().includes('empresa'))?.value || \"\",\n        contacto: $json.body.data.fields.find(f => f.label.toLowerCase().includes('contacto'))?.value || \"\",\n        correo: $json.body.data.fields.find(f => f.label.toLowerCase().includes('correo'))?.value || \"\",\n        telefono: $json.body.data.fields.find(f => f.label.toLowerCase().includes('teléfono'))?.value || \"\",\n        sitio_web: $json.body.data.fields.find(f => f.label.toLowerCase().includes('sitio'))?.value || \"\",\n\n        plan: $json.plan,\n\n        estado_onboarding: \"brief recibido\",\n        descripcion_negocio: $json.descripcion_negocio || \"\",\n        tono_marca: $json.tono_marca || \"\",\n        herramientas: $json.herramientas || \"\",\n        metricas: $json.metricas || \"\",\n        procesos: $json.procesos || \"\",\n        integraciones: $json.integraciones || \"\",\n        presupuesto: $json.presupuesto ? Number($json.presupuesto) : 0,\n        roles_equipo: $json.roles_equipo || \"\",\n        requerimientos: $json.requerimientos || \"\",\n        documentacion: $json.documentacion || \"\"\n      }\n    }\n  ]\n}\n}}",
